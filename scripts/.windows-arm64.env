# Platform env for windows-arm64.
# Sourced by scripts/env.sh after .common.env. Paths are relative to
# the repository root; env.sh anchors them to absolute paths.

PROJECT_PLATFORM="windows-arm64"

# Versioner is not bundled in this repository (it is the repo itself);
# scripts/version.sh falls back to `go run .` when VERSIONER_BIN is unset.
VERSIONER_BIN=""
LOGAMUFFIN_BIN="${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin.exe"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner.exe"
BARNACLE_BIN="${BARNACLE_VERSION_DIR}/${PROJECT_PLATFORM}/barnacle.exe"
